            <story_graph>
            {
              "acts": [
                {"id": "act1", "theme": "初遇",
                 "converge_to": [{"orbit": "信任�?, "guard": {"key": "trust_信长", "op": ">=", "value": 30}}],
                 "nodes": [
                   {"id": "n1_01", "type": "scene", "beat": "夜探织田�?,
                    "on_enter": {"trust_信长": 10}},
                   {"id": "n1_03", "type": "scene", "beat": "密谈"},
                   {"id": "n1_09", "type": "ending", "beat": "终局"}],
                 "edges": [
